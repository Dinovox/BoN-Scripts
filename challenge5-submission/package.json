{
  "name": "moltbot-starter-kit",
  "version": "1.0.0",
  "description": "MultiversX Agent Starter Kit (OpenClaw + x402)",
  "main": "dist/index.js",
  "scripts": {
    "setup": "bash setup.sh",
    "build": "tsc",
    "start": "node dist/index.js",
    "register": "ts-node scripts/register.ts",
    "update-manifest": "ts-node scripts/update_manifest.ts",
    "submit-job-proof": "ts-node scripts/submit-job-proof.ts",
    "validation-request": "ts-node scripts/validation-request.ts",
    "validation-response": "ts-node scripts/validation-response.ts",
    "challenge5:start": "ts-node src/challenge5-agent.ts",
    "challenge5:test": "jest tests/challenge5.test.ts --forceExit",
    "challenge5:test:unit": "jest tests/challenge5.test.ts --testNamePattern='Unit' --forceExit",
    "challenge5:test:integration": "jest tests/challenge5.test.ts --testNamePattern='Integration' --forceExit",
    "challenge5:inspect": "ts-node scripts/challenge5-inspect.ts",
    "challenge5:gen-wallets": "ts-node scripts/generate-wallets.ts",
    "challenge5:register-wallets": "ts-node scripts/register-wallets.ts",
    "challenge5:multi": "ts-node src/challenge5-orchestrator.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint"
  },
  "dependencies": {
    "@multiversx/sdk-core": "^15.3.2",
    "@multiversx/sdk-network-providers": "^2.9.3",
    "@multiversx/sdk-wallet": "^4.6.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "js-sha3": "^0.9.3"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.39.2",
    "gts": "^7.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.3"
  }
}
